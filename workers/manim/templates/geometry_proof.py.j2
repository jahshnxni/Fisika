from manim import *
from manim import config as mconfig

mconfig.background_color = "#0D1117"
ACCENT = "#58A6FF"
SUCCESS = "#3FB950"
MUTED = "#8B949E"
TEXT_COLOR = "#E6EDF3"

class {{ class_name }}(Scene):
    def construct(self):
        # ── Title ────────────────────────────────────────────────────────────
        {% if screen_text %}
        title = Text({{ screen_text[0]|tojson }}, font_size=40, color=TEXT_COLOR)
        title.to_edge(UP, buff=0.5)
        self.play(FadeIn(title), run_time=0.6)
        self.wait(0.3)
        {% endif %}

        # ── Geometry: build objects from LaTeX hints ──────────────────────────
        # For geometry we draw diagrams using Manim shapes and annotate with labels
        {% if latex_lines %}

        # Parse first latex line for geometry cues
        # Triangles
        {% if 'triangle' in (latex_lines[0]|lower) or 'segitiga' in (screen_text[0]|lower if screen_text else '') %}
        triangle = Triangle(color=ACCENT, fill_opacity=0.15, fill_color=ACCENT)
        triangle.scale(2.5).center()
        self.play(Create(triangle), run_time=1.0)

        # Label vertices
        labels = [
            Text("A", font_size=30, color=SUCCESS).next_to(triangle.get_vertices()[0], UP),
            Text("B", font_size=30, color=SUCCESS).next_to(triangle.get_vertices()[1], DL),
            Text("C", font_size=30, color=SUCCESS).next_to(triangle.get_vertices()[2], DR),
        ]
        self.play(*[Write(l) for l in labels], run_time=0.6)

        {% elif 'circle' in (latex_lines[0]|lower) or 'lingkaran' in (screen_text[0]|lower if screen_text else '') %}
        circle = Circle(radius=2.0, color=ACCENT, fill_opacity=0.1, fill_color=ACCENT)
        center_dot = Dot(ORIGIN, color=SUCCESS)
        radius_line = Line(ORIGIN, RIGHT * 2.0, color=MUTED)
        radius_label = MathTex("r", font_size=36, color=TEXT_COLOR).next_to(radius_line, UP, buff=0.1)
        self.play(Create(circle), run_time=0.8)
        self.play(Create(center_dot), GrowArrow(Arrow(ORIGIN, RIGHT * 2, color=MUTED)), run_time=0.6)
        self.play(Write(radius_label), run_time=0.4)

        {% else %}
        # Generic vector diagram
        axes = Axes(
            x_range=[-3, 3, 1], y_range=[-2, 2, 1],
            axis_config={"color": MUTED, "include_tip": True},
        ).scale(0.9)
        self.play(Create(axes), run_time=0.7)
        {% endif %}

        # ── Annotate with LaTeX formulas ─────────────────────────────────────
        {% for line in latex_lines %}
        formula_{{ loop.index0 }} = MathTex(r"{{ line }}", font_size=40, color={% if loop.index0 == 0 %}ACCENT{% else %}TEXT_COLOR{% endif %})
        formula_{{ loop.index0 }}.to_edge(DOWN, buff=0.4 + {{ loop.index0 }} * 0.55)
        self.play(Write(formula_{{ loop.index0 }}), run_time=0.8)
        {% endfor %}
        {% endif %}

        # ── Conclusion box ───────────────────────────────────────────────────
        {% if screen_text|length > 1 %}
        conclusion = Text({{ screen_text[-1]|tojson }}, font_size=28, color=SUCCESS)
        box = SurroundingRectangle(conclusion, color=SUCCESS, buff=0.2, corner_radius=0.08)
        conclusion.to_edge(DOWN, buff=0.2)
        box.surround(conclusion)
        self.play(Create(box), Write(conclusion), run_time=0.7)
        {% endif %}

        self.wait({{ [duration_sec - 4, 1.5] | max }})
        self.play(*[FadeOut(mob) for mob in self.mobjects], run_time=0.4)
